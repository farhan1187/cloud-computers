/* ==========================================================================
   CLOUD COMPUTERS - Component Styles
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Navigation Bar
   -------------------------------------------------------------------------- */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--navbar-height);
  z-index: 1000;
  display: flex;
  align-items: center;
  transition: background-color var(--transition-normal), 
              backdrop-filter var(--transition-normal), 
              border-color var(--transition-normal),
              box-shadow var(--transition-normal);
  border-bottom: 1px solid transparent;
}

.navbar.scrolled {
  background-color: rgba(6, 9, 19, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-subtle);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.navbar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: 0.5px;
}

.brand-logo .logo-icon {
  width: 36px;
  height: 36px;
  filter: drop-shadow(0 0 10px rgba(0, 180, 255, 0.6));
  transition: transform var(--transition-normal);
}

.brand-logo:hover .logo-icon {
  transform: scale(1.08);
}

.brand-logo .brand-text {
  color: #ffffff;
}

.brand-logo .brand-accent {
  color: var(--accent-blue);
  text-shadow: 0 0 12px rgba(0, 168, 255, 0.5);
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 32px;
  list-style: none;
}

.nav-link {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-secondary);
  position: relative;
  padding: 8px 0;
  transition: color var(--transition-fast);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 2px;
  background: var(--accent-cyan);
  box-shadow: 0 0 8px var(--accent-cyan);
  transition: width var(--transition-fast), left var(--transition-fast);
}

.nav-link:hover,
.nav-link.active {
  color: var(--text-white);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
  left: 0;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  width: 32px;
  padding: 4px 0;
  background: transparent;
  cursor: pointer;
}

.nav-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--text-white);
  border-radius: 2px;
  transition: transform var(--transition-normal), opacity var(--transition-normal);
}

/* --------------------------------------------------------------------------
   2. Buttons
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 24px;
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: 0.2px;
  border-radius: var(--radius-pill);
  transition: transform var(--transition-fast), 
              box-shadow var(--transition-fast), 
              background var(--transition-fast),
              border-color var(--transition-fast);
  text-decoration: none;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

.btn .btn-arrow {
  display: inline-block;
  transition: transform var(--transition-fast);
}

.btn:hover .btn-arrow {
  transform: translateX(4px);
}

.btn-primary {
  background: var(--grad-primary);
  color: #ffffff;
  border: 1px solid rgba(0, 229, 255, 0.4);
  box-shadow: 0 0 20px rgba(0, 145, 255, 0.4);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 30px rgba(0, 180, 255, 0.65), 0 4px 15px rgba(0, 114, 255, 0.4);
}

.btn-secondary {
  background: rgba(14, 22, 43, 0.6);
  color: var(--text-primary);
  border: 1px solid var(--border-medium);
  backdrop-filter: blur(8px);
}

.btn-secondary:hover {
  background: rgba(20, 32, 64, 0.85);
  border-color: var(--accent-cyan);
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 0 20px rgba(0, 180, 255, 0.3);
}

.btn-sm {
  padding: 8px 18px;
  font-size: 0.85rem;
}

/* Ripple effect on click */
.btn .ripple-wave {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0);
  animation: rippleAnimation 0.6s linear;
  pointer-events: none;
}

@keyframes rippleAnimation {
  to {
    transform: scale(4);
    opacity: 0;
  }
}

/* --------------------------------------------------------------------------
   3. Hero Section
   -------------------------------------------------------------------------- */
.hero-section {
  position: relative;
  min-height: 85vh;
  max-height: 960px;
  padding: calc(var(--navbar-height) + 20px) 0 40px;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-glow-ambient {
  position: absolute;
  top: 15%;
  right: 10%;
  width: 550px;
  height: 550px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 160, 255, 0.18) 0%, rgba(0, 80, 255, 0.05) 50%, transparent 70%);
  filter: blur(60px);
  pointer-events: none;
  z-index: 1;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-content {
  max-width: 600px;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent-cyan);
  margin-bottom: 20px;
}

.hero-title {
  font-size: 3.5rem;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -1px;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.hero-title .title-white {
  color: #ffffff;
}

.hero-title .title-blue {
  color: var(--accent-blue);
  background: linear-gradient(135deg, #00d2ff 0%, #0072ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 15px rgba(0, 168, 255, 0.4));
}

.hero-subtitle {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 20px;
  letter-spacing: -0.3px;
}

.hero-description {
  font-size: 1.08rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 36px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

/* Hero Graphic 3D Stage */
.hero-visual-container {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  perspective: 1200px;
}

.hero-graphic-wrapper {
  position: relative;
  width: 100%;
  max-width: 520px;
  transform-style: preserve-3d;
  transition: transform 0.1s ease-out;
}

.cloud-graphic-svg {
  width: 100%;
  height: auto;
  filter: drop-shadow(0 0 35px rgba(0, 180, 255, 0.5));
}

/* Mouse Scroll Down Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 28px;
  right: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  z-index: 10;
  opacity: 0.75;
  transition: opacity var(--transition-fast);
}

.scroll-indicator:hover {
  opacity: 1;
}

.mouse-icon {
  width: 20px;
  height: 32px;
  border: 2px solid var(--text-secondary);
  border-radius: 12px;
  position: relative;
  display: flex;
  justify-content: center;
}

.mouse-wheel {
  width: 3px;
  height: 6px;
  background-color: var(--accent-cyan);
  border-radius: 2px;
  position: absolute;
  top: 5px;
  animation: mouseScroll 1.8s infinite;
  box-shadow: 0 0 6px var(--accent-cyan);
}

@keyframes mouseScroll {
  0% { transform: translateY(0); opacity: 1; }
  75% { transform: translateY(10px); opacity: 0; }
  100% { transform: translateY(0); opacity: 0; }
}

.scroll-text {
  font-size: 0.7rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* --------------------------------------------------------------------------
   4. Services Grid (8 Cards)
   -------------------------------------------------------------------------- */
.services-section {
  padding: 100px 0;
  position: relative;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.service-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-md);
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: transform var(--transition-normal),
              border-color var(--transition-normal),
              box-shadow var(--transition-normal),
              background var(--transition-normal);
  cursor: pointer;
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
  opacity: 0;
  transition: opacity var(--transition-normal);
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: rgba(0, 180, 255, 0.45);
  background: var(--bg-card-hover);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 25px rgba(0, 168, 255, 0.25);
}

.service-card:hover::before {
  opacity: 1;
}

.service-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  background: rgba(0, 168, 255, 0.08);
  border: 1px solid rgba(0, 180, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  transition: transform var(--transition-normal),
              border-color var(--transition-normal),
              box-shadow var(--transition-normal);
}

.service-icon-wrap svg {
  width: 26px;
  height: 26px;
  stroke: var(--accent-cyan);
  filter: drop-shadow(0 0 8px rgba(0, 210, 255, 0.4));
  transition: transform var(--transition-normal);
}

.service-card:hover .service-icon-wrap {
  transform: scale(1.1);
  border-color: var(--accent-cyan);
  box-shadow: 0 0 16px rgba(0, 180, 255, 0.4);
}

.service-card:hover .service-icon-wrap svg {
  animation: pulseIcon 0.5s ease;
}

@keyframes pulseIcon {
  0% { transform: scale(1); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.service-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 12px;
  letter-spacing: -0.2px;
}

.service-desc {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   5. Networking Diagram Section
   -------------------------------------------------------------------------- */
.network-section {
  padding: 100px 0;
  position: relative;
  background: radial-gradient(circle at 75% 50%, rgba(0, 120, 255, 0.08) 0%, transparent 60%);
}

.network-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.25fr;
  gap: 50px;
  align-items: center;
}

.network-info {
  max-width: 480px;
}

.network-info .section-tag {
  text-align: left;
}

.network-info .section-title {
  text-align: left;
  margin-bottom: 20px;
}

.network-info .network-desc {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 32px;
}

/* Network Topology Diagram Container */
.network-diagram-container {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 11;
  background: rgba(8, 13, 27, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 0 40px rgba(0, 120, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  overflow: visible;
}

/* SVG Line Canvas */
.network-svg-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.network-svg-lines path {
  fill: none;
  stroke: rgba(0, 168, 255, 0.45);
  stroke-width: 2.5;
  stroke-linecap: round;
  filter: drop-shadow(0 0 6px rgba(0, 200, 255, 0.6));
}

/* Animated Data Flowing Packets */
.data-packet {
  fill: #00ffff;
  filter: drop-shadow(0 0 8px #00ffff);
}

/* Topology Node Elements */
.network-nodes-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: auto;
}

.net-node {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
  cursor: pointer;
  transition: transform var(--transition-normal);
}

.net-node:hover {
  transform: translate(-50%, -50%) scale(1.12);
  z-index: 20;
}

.node-icon-box {
  position: relative;
  width: 64px;
  height: 64px;
  border-radius: 16px;
  background: rgba(12, 19, 39, 0.9);
  border: 1.5px solid rgba(0, 180, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 15px rgba(0, 168, 255, 0.25);
  transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
}

.net-node:hover .node-icon-box {
  border-color: var(--accent-cyan);
  box-shadow: 0 0 25px rgba(0, 229, 255, 0.65), 0 8px 30px rgba(0, 0, 0, 0.8);
}

.node-icon-box svg {
  width: 32px;
  height: 32px;
  stroke: var(--accent-cyan);
}

.node-label {
  margin-top: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-primary);
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
  white-space: nowrap;
}

/* Central Switch Node */
.node-switch {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  cursor: pointer;
  transition: transform var(--transition-normal);
}

.node-switch:hover {
  transform: translate(-50%, -50%) scale(1.06);
}

.switch-rack-box {
  position: relative;
  width: 170px;
  padding: 12px 14px;
  background: linear-gradient(180deg, #131c38 0%, #0c142b 100%);
  border: 1.5px solid rgba(0, 210, 255, 0.45);
  border-radius: 10px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 168, 255, 0.3);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.switch-ports-row {
  display: flex;
  justify-content: space-between;
  gap: 3px;
}

.switch-port {
  width: 7px;
  height: 6px;
  background: #0d2847;
  border-radius: 1px;
  border: 1px solid rgba(0, 200, 255, 0.3);
  position: relative;
}

.switch-port.active::after {
  content: '';
  position: absolute;
  top: 1px;
  left: 1px;
  width: 3px;
  height: 2px;
  background: #00ffaa;
  box-shadow: 0 0 4px #00ffaa;
  animation: blinkPort 1.5s infinite alternate;
}

.switch-port.active:nth-child(2n)::after {
  animation-delay: 0.3s;
  background: #00e5ff;
  box-shadow: 0 0 4px #00e5ff;
}

@keyframes blinkPort {
  0% { opacity: 0.3; }
  100% { opacity: 1; }
}

.switch-label-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--accent-cyan);
  letter-spacing: 0.8px;
}

/* Interactive Node Tooltip */
.node-tooltip {
  position: absolute;
  bottom: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  background: rgba(6, 11, 25, 0.95);
  border: 1px solid var(--accent-cyan);
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 0.75rem;
  color: #fff;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-fast);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(0, 180, 255, 0.3);
  z-index: 30;
}

.net-node:hover .node-tooltip,
.node-switch:hover .node-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

/* --------------------------------------------------------------------------
   6. Product Carousel Section
   -------------------------------------------------------------------------- */
.products-section {
  padding: 100px 0;
  position: relative;
  overflow: hidden;
}

.carousel-container {
  position: relative;
  width: 100%;
  margin-top: 20px;
}

.carousel-viewport {
  width: 100%;
  overflow: hidden;
  padding: 30px 0 40px;
  cursor: grab;
  user-select: none;
}

.carousel-viewport:active {
  cursor: grabbing;
}

.carousel-track {
  display: flex;
  gap: 24px;
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  will-change: transform;
}

.product-card {
  flex: 0 0 270px;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-md);
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: transform var(--transition-normal), 
              border-color var(--transition-normal), 
              box-shadow var(--transition-normal);
  position: relative;
}

.product-card:hover,
.product-card.active-card {
  transform: translateY(-8px) scale(1.03);
  border-color: rgba(0, 210, 255, 0.5);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 168, 255, 0.28);
}

.product-img-wrap {
  width: 100%;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  position: relative;
}

.product-img-wrap svg,
.product-img-wrap img {
  max-width: 90%;
  max-height: 90%;
  object-fit: contain;
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.6));
  transition: transform var(--transition-normal);
}

.product-card:hover .product-img-wrap svg,
.product-card:hover .product-img-wrap img {
  transform: scale(1.06);
}

.product-info-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
}

.product-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.product-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-white);
}

.product-tagline {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.product-arrow-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 168, 255, 0.1);
  border: 1px solid rgba(0, 180, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-cyan);
  transition: all var(--transition-fast);
}

.product-card:hover .product-arrow-btn {
  background: var(--accent-blue);
  color: #fff;
  border-color: var(--accent-cyan);
  box-shadow: 0 0 12px var(--accent-blue);
}

/* Carousel Controls */
.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(10, 16, 32, 0.85);
  border: 1px solid var(--border-medium);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  backdrop-filter: blur(8px);
  transition: all var(--transition-fast);
}

.carousel-btn:hover {
  background: rgba(0, 140, 255, 0.25);
  border-color: var(--accent-cyan);
  color: #ffffff;
  box-shadow: 0 0 16px rgba(0, 180, 255, 0.4);
}

.carousel-btn-prev { left: -16px; }
.carousel-btn-next { right: -16px; }

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 10px;
}

.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.carousel-dot.active {
  width: 24px;
  border-radius: 4px;
  background: var(--accent-cyan);
  box-shadow: 0 0 10px var(--accent-cyan);
}

/* --------------------------------------------------------------------------
   7. Stats Section ("Why Choose Us")
   -------------------------------------------------------------------------- */
.stats-section {
  padding: 100px 0;
  position: relative;
  background: linear-gradient(180deg, transparent 0%, rgba(8, 14, 28, 0.6) 50%, transparent 100%);
}

.stats-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.3fr;
  gap: 50px;
  align-items: center;
}

.stats-visual-rack {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  height: 380px;
}

.stats-rack-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.2) contrast(1.1);
}

.stats-rack-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(6, 9, 19, 0.2) 0%, rgba(6, 9, 19, 0.7) 100%),
              radial-gradient(circle at 30% 50%, rgba(0, 168, 255, 0.15) 0%, transparent 60%);
}

.stats-content .section-tag,
.stats-content .section-title,
.stats-content .section-subtitle {
  text-align: left;
}

.stats-content .section-subtitle {
  margin-bottom: 40px;
}

.stats-cards-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stat-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(0, 168, 255, 0.08);
  border: 1px solid rgba(0, 180, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon svg {
  width: 22px;
  height: 22px;
  stroke: var(--accent-cyan);
  filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.4));
}

.stat-text {
  display: flex;
  flex-direction: column;
}

.stat-number-wrap {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.1;
  letter-spacing: -0.5px;
}

.stat-number {
  color: var(--text-white);
}

.stat-label {
  font-size: 0.75rem;
  color: var(--text-secondary);
  font-weight: 500;
  margin-top: 2px;
}

/* --------------------------------------------------------------------------
   8. Trusted Brands
   -------------------------------------------------------------------------- */
.brands-section {
  padding: 60px 0;
  text-align: center;
}

.brands-tag {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent-cyan);
  margin-bottom: 32px;
}

.brands-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 36px;
  flex-wrap: wrap;
  padding: 10px 0;
}

.brand-item {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.55;
  filter: grayscale(100%) brightness(1.2);
  transition: all var(--transition-normal);
  cursor: pointer;
}

.brand-item svg,
.brand-item img {
  height: 28px;
  width: auto;
  max-width: 110px;
}

.brand-item:hover {
  opacity: 1;
  filter: grayscale(0%) brightness(1.4) drop-shadow(0 0 10px rgba(0, 180, 255, 0.5));
  transform: translateY(-2px);
}

/* --------------------------------------------------------------------------
   9. CTA Banner
   -------------------------------------------------------------------------- */
.cta-section {
  padding: 40px 0 80px;
}

.cta-banner {
  position: relative;
  background: linear-gradient(135deg, rgba(12, 20, 42, 0.85) 0%, rgba(8, 14, 30, 0.95) 100%);
  border: 1px solid rgba(0, 180, 255, 0.3);
  border-radius: var(--radius-lg);
  padding: 32px 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 35px rgba(0, 168, 255, 0.15);
  overflow: hidden;
}

.cta-banner::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -20%;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(0, 180, 255, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.cta-left {
  display: flex;
  align-items: center;
  gap: 24px;
}

.cta-cloud-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(0, 168, 255, 0.1);
  border: 1px solid rgba(0, 229, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 20px rgba(0, 168, 255, 0.25);
}

.cta-cloud-icon svg {
  width: 28px;
  height: 28px;
  stroke: var(--accent-cyan);
}

.cta-text {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.cta-title {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-white);
  letter-spacing: -0.2px;
}

.cta-desc {
  font-size: 0.92rem;
  color: var(--text-secondary);
}

/* --------------------------------------------------------------------------
   10. Footer
   -------------------------------------------------------------------------- */
.site-footer {
  border-top: 1px solid var(--border-subtle);
  background: rgba(4, 6, 13, 0.9);
  padding: 40px 0 30px;
  position: relative;
  z-index: 10;
}

.footer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 28px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  flex-wrap: wrap;
  gap: 20px;
}

.footer-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
}

.footer-link {
  font-size: 0.88rem;
  color: var(--text-muted);
  transition: color var(--transition-fast);
}

.footer-link:hover {
  color: var(--accent-cyan);
}

.footer-socials {
  display: flex;
  align-items: center;
  gap: 16px;
}

.social-icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.social-icon-btn svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

.social-icon-btn:hover {
  background: rgba(0, 168, 255, 0.15);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(0, 180, 255, 0.35);
  transform: translateY(-2px);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24px;
  font-size: 0.82rem;
  color: var(--text-muted);
  flex-wrap: wrap;
  gap: 12px;
}

.footer-motto {
  letter-spacing: 2px;
  font-weight: 600;
  color: var(--accent-blue);
  opacity: 0.8;
}

/* --------------------------------------------------------------------------
   11. Interactive Quote Modal & Toast
   -------------------------------------------------------------------------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(3, 5, 12, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-normal), visibility var(--transition-normal);
  padding: 20px;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-card {
  width: 100%;
  max-width: 540px;
  background: linear-gradient(135deg, #0c142b 0%, #080d1e 100%);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  padding: 36px 32px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 40px rgba(0, 180, 255, 0.25);
  transform: scale(0.92) translateY(20px);
  transition: transform var(--transition-normal);
  position: relative;
}

.modal-overlay.active .modal-card {
  transform: scale(1) translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24px;
}

.modal-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-white);
}

.modal-desc {
  font-size: 0.88rem;
  color: var(--text-secondary);
  margin-top: 4px;
}

.modal-close-btn {
  font-size: 1.8rem;
  line-height: 1;
  color: var(--text-muted);
  cursor: pointer;
  transition: color var(--transition-fast);
}

.modal-close-btn:hover {
  color: var(--accent-cyan);
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-label {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-primary);
}

.form-input,
.form-select,
.form-textarea {
  width: 100%;
  background: rgba(14, 22, 44, 0.8);
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: 0.9rem;
  color: #fff;
  outline: none;
  font-family: inherit;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
}

.form-select option {
  background: #090e1f;
  color: #fff;
}

.form-textarea {
  resize: vertical;
  min-height: 80px;
}

/* Toast Notification */
.toast-notification {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #0c1833;
  border: 1px solid var(--accent-cyan);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 229, 255, 0.4);
  color: #fff;
  padding: 14px 20px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.9rem;
  font-weight: 500;
  z-index: 3000;
  transform: translateY(100px);
  opacity: 0;
  transition: all var(--transition-normal);
}

.toast-notification.active {
  transform: translateY(0);
  opacity: 1;
}

/* --------------------------------------------------------------------------
   Responsive Media Queries
   -------------------------------------------------------------------------- */
@media (max-width: 1100px) {
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .network-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .network-info {
    max-width: 100%;
    text-align: center;
  }
  .network-info .section-tag,
  .network-info .section-title {
    text-align: center;
  }
  .stats-grid {
    grid-template-columns: 1fr;
  }
  .stats-visual-rack {
    height: 280px;
  }
}

@media (max-width: 900px) {
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 40px;
  }
  .hero-content {
    max-width: 100%;
    margin: 0 auto;
  }
  .hero-actions {
    justify-content: center;
  }
  .hero-title {
    font-size: 2.8rem;
  }
  .stats-cards-row {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .nav-menu {
    position: fixed;
    top: var(--navbar-height);
    left: 0;
    width: 100%;
    background: rgba(6, 9, 19, 0.96);
    backdrop-filter: blur(20px);
    flex-direction: column;
    padding: 30px 24px;
    gap: 20px;
    border-bottom: 1px solid var(--border-subtle);
    transform: translateY(-120%);
    opacity: 0;
    transition: all var(--transition-normal);
    pointer-events: none;
  }
  .nav-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .nav-toggle {
    display: flex;
  }
  .services-grid {
    grid-template-columns: 1fr;
  }
  .cta-banner {
    flex-direction: column;
    text-align: center;
    padding: 30px 20px;
  }
  .cta-left {
    flex-direction: column;
  }
  .footer-top {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }
  .footer-nav {
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2.2rem;
  }
  .hero-subtitle {
    font-size: 1.35rem;
  }
  .section-title {
    font-size: 1.85rem;
  }
  .stats-cards-row {
    grid-template-columns: 1fr;
  }
}
