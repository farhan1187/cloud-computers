/**
 * CLOUD COMPUTERS - Three.js 3D Architectural Studio & "Pop Out Services" Engine
 * Theme: Ethereal White Architectural Studio with Volumetric Fluffy Cloud
 * Features:
 *  - 3D Studio Room with reflective floor and soft contact shadows
 *  - Photorealistic volumetric cumulus cloud cluster formed by soft physical billows
 *  - Spatial 3D "Pop Out Services" system where 8 services explode out in 3D orbit
 *  - Screen-projected interactive HTML cards with smooth elastic physics
 *  - Mouse parallax, breathing idle animations, and WhatsApp integration
 */

(function () {
  'use strict';

  let scene, camera, renderer;
  let studioRoom, cloudGroup, shadowMesh;
  let serviceNodes = [];
  let isPoppedOut = false;
  let mouseX = 0, mouseY = 0;
  let targetRotationX = 0, targetRotationY = 0;
  let container, badgeElements = [];

  const SERVICES_DATA = [
    { id: 'networking', num: '01', title: 'Enterprise Networking', cat: 'ROUTERS & SWITCHES', icon: '🌐', anchor: { x: -2.1, y: 1.45, z: 0.9 } },
    { id: 'pc-sales', num: '02', title: 'PC Sales & Services', cat: 'WORKSTATIONS & PCS', icon: '💻', anchor: { x: 2.1, y: 1.45, z: 0.9 } },
    { id: 'cabling', num: '03', title: 'Structured Cabling', cat: 'CAT6A & FIBER OPTIC', icon: '⚡', anchor: { x: -2.25, y: 0.05, z: 1.0 } },
    { id: 'security', num: '04', title: 'Access & Security', cat: 'BIOMETRICS & SIRA', icon: '🛡️', anchor: { x: 2.25, y: 0.05, z: 1.0 } },
    { id: 'it-solutions', num: '05', title: 'Cloud & IT Solutions', cat: 'SAN, BACKUP & DR', icon: '☁️', anchor: { x: -2.0, y: -1.35, z: 0.9 } },
    { id: 'wifi', num: '06', title: 'Wi-Fi Solutions', cat: 'HIGH-DENSITY APS', icon: '📶', anchor: { x: 2.0, y: -1.35, z: 0.9 } },
    { id: 'printers', num: '07', title: 'Printer Solutions', cat: 'COMMERCIAL PRINTERS', icon: '🖨️', anchor: { x: -1.35, y: 2.25, z: 0.7 } },
    { id: 'support', num: '08', title: '24/7 Tech Support', cat: 'SLA RESPONSE TEAMS', icon: '🛠️', anchor: { x: 1.35, y: 2.25, z: 0.7 } }
  ];

  function createSoftShadowTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(128, 128, 0, 128, 128, 120);
    grad.addColorStop(0, 'rgba(15, 23, 42, 0.35)');
    grad.addColorStop(0.3, 'rgba(30, 41, 59, 0.20)');
    grad.addColorStop(0.65, 'rgba(51, 65, 85, 0.08)');
    grad.addColorStop(1, 'rgba(240, 240, 243, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 256, 256);
    return new THREE.CanvasTexture(canvas);
  }

  function init() {
    container = document.getElementById('hero-three-canvas');
    if (!container || typeof THREE === 'undefined') return;

    // 1. Scene & Camera
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf3f3f6);

    const width = container.clientWidth || 800;
    const height = container.clientHeight || 560;

    camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 1000);
    camera.position.set(0, 0.4, 10.5);

    // 2. WebGL Renderer
    try {
      renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: false,
        powerPreference: 'high-performance'
      });
    } catch (e) {
      console.warn('WebGL init failed:', e);
      return;
    }

    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.innerHTML = '';
    container.appendChild(renderer.domElement);

    // 3. Studio Lighting System (High-Key Ethereal Architectural Studio)
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.6);
    scene.add(ambientLight);

    const mainKeyLight = new THREE.DirectionalLight(0xfffaf0, 2.0);
    mainKeyLight.position.set(6, 9, 8);
    scene.add(mainKeyLight);

    const fillLight = new THREE.DirectionalLight(0xf0f5ff, 1.2);
    fillLight.position.set(-7, 6, 6);
    scene.add(fillLight);

    const topRimLight = new THREE.DirectionalLight(0xffffff, 1.4);
    topRimLight.position.set(0, 10, 0);
    scene.add(topRimLight);

    const softFrontLight = new THREE.PointLight(0xffffff, 0.8, 20);
    softFrontLight.position.set(0, 0, 6);
    scene.add(softFrontLight);

    // 4. Build 3D Studio Room (Matching Reference Photo)
    buildStudioRoom();

    // 5. Build Photorealistic Volumetric Fluffy Cloud
    buildVolumetricCloud();

    // 6. Build Soft Floor Contact Shadow
    buildContactShadow();

    // 7. Build Spatial "Pop Out Services" System
    buildPopOutServices();

    // 8. Event Listeners
    setupEvents();

    // 9. Start Animation Loop
    animate();
  }

  function buildStudioRoom() {
    studioRoom = new THREE.Group();
    scene.add(studioRoom);

    const wallMat = new THREE.MeshStandardMaterial({
      color: 0xeeeff3,
      roughness: 0.96,
      metalness: 0.01
    });

    const floorMat = new THREE.MeshStandardMaterial({
      color: 0xf5f5f8,
      roughness: 0.32,
      metalness: 0.06
    });

    const ceilingMat = new THREE.MeshStandardMaterial({
      color: 0xfbfbfd,
      roughness: 0.98,
      metalness: 0.0
    });

    // Back Wall
    const backWall = new THREE.Mesh(new THREE.PlaneGeometry(32, 20), wallMat);
    backWall.position.set(0, 0, -6.5);
    studioRoom.add(backWall);

    // Floor (Glossy studio reflection)
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(32, 20), floorMat);
    floor.position.set(0, -3.8, 0);
    floor.rotation.x = -Math.PI / 2;
    studioRoom.add(floor);

    // Ceiling
    const ceiling = new THREE.Mesh(new THREE.PlaneGeometry(32, 20), ceilingMat);
    ceiling.position.set(0, 6.5, 0);
    ceiling.rotation.x = Math.PI / 2;
    studioRoom.add(ceiling);

    // Left Wall
    const leftWall = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), wallMat);
    leftWall.position.set(-13, 0, 0);
    leftWall.rotation.y = Math.PI / 2;
    studioRoom.add(leftWall);

    // Right Wall
    const rightWall = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), wallMat);
    rightWall.position.set(13, 0, 0);
    rightWall.rotation.y = -Math.PI / 2;
    studioRoom.add(rightWall);
  }

  function buildVolumetricCloud() {
    cloudGroup = new THREE.Group();
    cloudGroup.position.set(0, 0.4, 0);
    scene.add(cloudGroup);

    // Soft Physical Material with Subsurface Scattering Light Effect
    const cloudMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      emissive: 0xffffff,
      emissiveIntensity: 0.08,
      roughness: 0.88,
      metalness: 0.02
    });

    // Cumulus Cloud Billow Specifications (Clustered to reproduce the reference photo)
    const billowPuffs = [
      // Core center mass
      { x: 0.0, y: 0.0, z: 0.0, r: 1.25, sy: 0.82 },
      { x: -0.8, y: 0.1, z: 0.2, r: 1.15, sy: 0.85 },
      { x: 0.85, y: 0.05, z: 0.15, r: 1.18, sy: 0.82 },
      { x: -1.6, y: -0.15, z: 0.05, r: 0.95, sy: 0.8 },
      { x: 1.65, y: -0.1, z: 0.1, r: 0.98, sy: 0.78 },
      
      // Top towering cumulus domes
      { x: 0.25, y: 0.65, z: 0.1, r: 0.95, sy: 0.9 },
      { x: -0.55, y: 0.6, z: 0.0, r: 0.9, sy: 0.9 },
      { x: 0.9, y: 0.5, z: -0.1, r: 0.8, sy: 0.88 },
      { x: -1.15, y: 0.45, z: -0.05, r: 0.75, sy: 0.85 },
      
      // Front fluffy lobe puff details
      { x: -0.4, y: -0.1, z: 0.65, r: 0.82, sy: 0.8 },
      { x: 0.45, y: -0.05, z: 0.7, r: 0.85, sy: 0.8 },
      { x: -1.1, y: -0.2, z: 0.55, r: 0.7, sy: 0.75 },
      { x: 1.2, y: -0.15, z: 0.6, r: 0.72, sy: 0.78 },
      { x: 0.0, y: 0.35, z: 0.5, r: 0.75, sy: 0.82 },

      // Back volume
      { x: -0.3, y: 0.1, z: -0.6, r: 0.9, sy: 0.85 },
      { x: 0.5, y: 0.15, z: -0.65, r: 0.88, sy: 0.85 },
      { x: -1.2, y: 0.0, z: -0.5, r: 0.75, sy: 0.8 },
      { x: 1.25, y: 0.05, z: -0.55, r: 0.78, sy: 0.8 },

      // Left & Right subtle wisps
      { x: -2.2, y: -0.28, z: 0.0, r: 0.62, sy: 0.7 },
      { x: -2.55, y: -0.35, z: 0.05, r: 0.48, sy: 0.65 },
      { x: 2.25, y: -0.22, z: 0.0, r: 0.68, sy: 0.72 },
      { x: 2.65, y: -0.32, z: 0.05, r: 0.52, sy: 0.68 },

      // Flat underside cumulus fill
      { x: 0.0, y: -0.38, z: 0.0, r: 0.95, sy: 0.6 },
      { x: -0.9, y: -0.4, z: 0.1, r: 0.8, sy: 0.58 },
      { x: 0.9, y: -0.38, z: 0.1, r: 0.82, sy: 0.6 },
      { x: -1.6, y: -0.42, z: 0.0, r: 0.65, sy: 0.55 },
      { x: 1.6, y: -0.4, z: 0.0, r: 0.68, sy: 0.55 }
    ];

    billowPuffs.forEach((p) => {
      const geo = new THREE.SphereGeometry(p.r, 24, 20);
      geo.scale(1.0, p.sy || 0.85, 0.9);
      const mesh = new THREE.Mesh(geo, cloudMat);
      mesh.position.set(p.x, p.y, p.z);
      cloudGroup.add(mesh);
    });

    // Gentle global scale to fit comfortable hero view
    cloudGroup.scale.set(1.08, 1.08, 1.08);
  }

  function buildContactShadow() {
    const shadowGeo = new THREE.PlaneGeometry(6.4, 2.6);
    const shadowTex = createSoftShadowTexture();
    const shadowMat = new THREE.MeshBasicMaterial({
      map: shadowTex,
      transparent: true,
      opacity: 0.75,
      depthWrite: false
    });

    shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
    shadowMesh.position.set(0, -3.78, 0);
    shadowMesh.rotation.x = -Math.PI / 2;
    scene.add(shadowMesh);
  }

  function buildPopOutServices() {
    // 1. Create 3D anchor beacons and connector lines
    const lineMat = new THREE.LineBasicMaterial({
      color: 0x0284c7,
      transparent: true,
      opacity: 0.35
    });

    SERVICES_DATA.forEach((s) => {
      const nodeGroup = new THREE.Group();
      nodeGroup.position.set(s.anchor.x, s.anchor.y, s.anchor.z);
      nodeGroup.scale.set(0.001, 0.001, 0.001); // starts collapsed inside the cloud

      // Beacon sphere
      const beaconGeo = new THREE.SphereGeometry(0.09, 16, 16);
      const beaconMat = new THREE.MeshBasicMaterial({ color: 0x0284c7 });
      const beaconMesh = new THREE.Mesh(beaconGeo, beaconMat);
      nodeGroup.add(beaconMesh);

      // Pulse ring
      const ringGeo = new THREE.RingGeometry(0.12, 0.16, 24);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.6,
        side: THREE.DoubleSide
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      nodeGroup.add(ringMesh);

      // Connector line from origin to node
      const points = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(s.anchor.x * 0.9, s.anchor.y * 0.9, s.anchor.z * 0.9)];
      const lineGeo = new THREE.BufferGeometry().setFromPoints(points);
      const lineMesh = new THREE.Line(lineGeo, lineMat);
      lineMesh.scale.set(0.001, 0.001, 0.001);

      scene.add(lineMesh);
      scene.add(nodeGroup);

      serviceNodes.push({
        data: s,
        nodeGroup: nodeGroup,
        lineMesh: lineMesh,
        targetPos: new THREE.Vector3(s.anchor.x, s.anchor.y, s.anchor.z)
      });
    });

    // 2. Create or bind screen-projected HTML floating cards
    createHtmlServiceBadges();
  }

  function createHtmlServiceBadges() {
    let overlay = document.getElementById('hero-spatial-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'hero-spatial-overlay';
      overlay.className = 'hero-spatial-overlay';
      container.parentElement.appendChild(overlay);
    }
    overlay.innerHTML = '';
    badgeElements = [];

    SERVICES_DATA.forEach((s) => {
      const badge = document.createElement('div');
      badge.className = 'spatial-service-card';
      badge.setAttribute('data-service', s.id);
      badge.innerHTML = `
        <div class="spatial-card-inner">
          <div class="spatial-card-icon">${s.icon}</div>
          <div class="spatial-card-content">
            <span class="spatial-card-num">PHASE ${s.num}</span>
            <h4 class="spatial-card-title">${s.title}</h4>
            <span class="spatial-card-cat">${s.cat}</span>
          </div>
          <a href="https://wa.me/971553350141?text=Hello%20Cloud%20Computers,%20I%20am%20interested%20in%20${encodeURIComponent(s.title)}." 
             target="_blank" 
             rel="noopener noreferrer" 
             class="spatial-wa-btn" 
             title="Inquire on WhatsApp">
            <svg viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </a>
        </div>
      `;

      badge.addEventListener('click', (e) => {
        if (!e.target.closest('.spatial-wa-btn')) {
          const targetEl = document.getElementById(s.id) || document.getElementById('services');
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });

      overlay.appendChild(badge);
      badgeElements.push({ id: s.id, element: badge, anchor: s.anchor });
    });
  }

  function updateBadgePositions() {
    if (!renderer || !camera || !container) return;
    const rect = container.getBoundingClientRect();
    const halfW = rect.width / 2;
    const halfH = rect.height / 2;

    serviceNodes.forEach((node, i) => {
      const badgeObj = badgeElements[i];
      if (!badgeObj) return;

      const wp = new THREE.Vector3();
      node.nodeGroup.getWorldPosition(wp);
      wp.project(camera);

      // If in front of camera
      if (wp.z < 1) {
        const rawX = (wp.x * halfW) + halfW;
        const rawY = -(wp.y * halfH) + halfH;
        // Keep badges neatly framed inside the stage bounds
        const padX = 100;
        const padY = 32;
        const x = Math.max(padX, Math.min(rect.width - padX, rawX));
        const y = Math.max(padY, Math.min(rect.height - padY, rawY));
        badgeObj.element.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(${node.nodeGroup.scale.x})`;
        badgeObj.element.style.opacity = node.nodeGroup.scale.x > 0.1 ? (node.nodeGroup.scale.x) : '0';
        badgeObj.element.style.pointerEvents = isPoppedOut ? 'auto' : 'none';
      } else {
        badgeObj.element.style.opacity = '0';
        badgeObj.element.style.pointerEvents = 'none';
      }
    });
  }

  function togglePopOutServices(forceState) {
    const newState = (forceState !== undefined) ? forceState : !isPoppedOut;
    isPoppedOut = newState;

    const btnTrigger = document.getElementById('btn-popout-services');
    if (btnTrigger) {
      if (isPoppedOut) {
        btnTrigger.classList.add('active');
        btnTrigger.innerHTML = `<span>Collapse Services</span> <span class="btn-icon">×</span>`;
      } else {
        btnTrigger.classList.remove('active');
        btnTrigger.innerHTML = `<span>Pop Out Services</span> <span class="btn-icon">✨</span>`;
      }
    }

    serviceNodes.forEach((node, idx) => {
      if (typeof gsap !== 'undefined') {
        if (isPoppedOut) {
          gsap.to(node.nodeGroup.scale, {
            x: 1.0,
            y: 1.0,
            z: 1.0,
            duration: 0.9,
            delay: idx * 0.05,
            ease: 'elastic.out(1.1, 0.65)'
          });
          gsap.to(node.lineMesh.scale, {
            x: 1.0,
            y: 1.0,
            z: 1.0,
            duration: 0.7,
            delay: idx * 0.04,
            ease: 'power2.out'
          });
        } else {
          gsap.to(node.nodeGroup.scale, {
            x: 0.001,
            y: 0.001,
            z: 0.001,
            duration: 0.4,
            delay: (serviceNodes.length - idx) * 0.02,
            ease: 'power2.in'
          });
          gsap.to(node.lineMesh.scale, {
            x: 0.001,
            y: 0.001,
            z: 0.001,
            duration: 0.3,
            ease: 'power2.in'
          });
        }
      } else {
        const s = isPoppedOut ? 1 : 0.001;
        node.nodeGroup.scale.set(s, s, s);
        node.lineMesh.scale.set(s, s, s);
      }
    });
  }

  function setupEvents() {
    // Mouse movement inside hero
    window.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth) * 2 - 1;
      mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      targetRotationY = mouseX * 0.25;
      targetRotationX = mouseY * 0.15;
    });

    // Window resize
    window.addEventListener('resize', () => {
      if (!container || !renderer || !camera) return;
      const w = container.clientWidth || 800;
      const h = container.clientHeight || 560;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });

    // Pop Out button trigger
    const popBtn = document.getElementById('btn-popout-services');
    if (popBtn) {
      popBtn.addEventListener('click', (e) => {
        e.preventDefault();
        togglePopOutServices();
      });
    }

    // Auto-pop out after brief landing presentation (2 seconds)
    setTimeout(() => {
      if (!isPoppedOut) {
        togglePopOutServices(true);
      }
    }, 1800);
  }

  function animate() {
    requestAnimationFrame(animate);

    const time = performance.now() * 0.001;

    // Hover breathing for volumetric cloud
    if (cloudGroup) {
      const hoverY = 0.4 + Math.sin(time * 1.3) * 0.12;
      cloudGroup.position.y = hoverY;

      // Soft rotation easing toward cursor
      cloudGroup.rotation.y += (targetRotationY - cloudGroup.rotation.y) * 0.06;
      cloudGroup.rotation.x += (-targetRotationX - cloudGroup.rotation.x) * 0.06;

      // Synchronize floor contact shadow scale & opacity
      if (shadowMesh) {
        const shadowScale = 1.0 - (hoverY - 0.4) * 0.4;
        shadowMesh.scale.set(shadowScale, shadowScale, 1.0);
        shadowMesh.material.opacity = 0.72 - (hoverY - 0.4) * 0.3;
      }
    }

    // Subtle breathing of service nodes in 3D orbit
    if (isPoppedOut && serviceNodes.length > 0) {
      serviceNodes.forEach((node, i) => {
        const offset = i * 0.8;
        node.nodeGroup.position.y = node.targetPos.y + Math.sin(time * 1.5 + offset) * 0.06;
      });
    }

    // Update screen-projected HTML badges
    updateBadgePositions();

    renderer.render(scene, camera);
  }

  // Export for global access and testing
  window.cloudStudioEngine = {
    togglePopOutServices,
    isPoppedOut: () => isPoppedOut,
    getScene: () => scene,
    getCloud: () => cloudGroup
  };

  // Initialize once DOM is loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
