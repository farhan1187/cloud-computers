/* ==========================================================================
   CLOUD COMPUTERS - Components & Next-Gen 3D UI System
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. NAVBAR (Glassmorphism Capsule)
   -------------------------------------------------------------------------- */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--navbar-height);
  z-index: 1000;
  display: flex;
  align-items: center;
  background: rgba(251, 251, 253, 0.88);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  transition: all var(--transition-normal);
}

.navbar.scrolled {
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  border-bottom-color: rgba(0, 0, 0, 0.08);
}

.navbar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Brand Logo with Soft Gallery Shadow */
.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-logo-img {
  width: 38px;
  height: 38px;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(2, 132, 199, 0.35));
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
}

.brand-logo:hover .brand-logo-img {
  transform: rotate(-6deg) scale(1.08);
  filter: drop-shadow(0 4px 14px rgba(2, 132, 199, 0.5));
}

.brand-text {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: 1px;
  color: #0f172a;
  display: flex;
  align-items: center;
  gap: 4px;
}

.brand-accent {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 900;
}

/* Navigation Links */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
}

.nav-link {
  font-size: 0.9rem;
  font-weight: 600;
  color: #475569;
  text-decoration: none;
  position: relative;
  padding: 6px 0;
  transition: color var(--transition-fast);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background: #0284c7;
  border-radius: 2px;
  transition: width var(--transition-normal);
}

.nav-link:hover,
.nav-link.active {
  color: #0f172a;
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Mobile Nav Toggle */
.nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 1001;
}

.nav-toggle span {
  width: 100%;
  height: 2px;
  background: #0f172a;
  border-radius: 2px;
  transition: all var(--transition-normal);
}

.nav-toggle.open span:nth-child(1) {
  transform: translateY(9px) rotate(45deg);
}

.nav-toggle.open span:nth-child(2) {
  opacity: 0;
}

.nav-toggle.open span:nth-child(3) {
  transform: translateY(-9px) rotate(-45deg);
}

/* --------------------------------------------------------------------------
   2. BUTTONS & PILLS (Studio Architectural Aesthetics)
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: var(--font-main);
  font-size: 0.9rem;
  font-weight: 600;
  padding: 10px 22px;
  border-radius: 12px;
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all var(--transition-normal);
  position: relative;
  user-select: none;
}

.btn-primary {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
}

.btn-primary:hover {
  background: #1e293b;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
}

.btn-popout {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(2, 132, 199, 0.3);
}

.btn-popout:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 8px 25px rgba(2, 132, 199, 0.45);
}

.btn-popout.active {
  background: #0f172a;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.2);
}

.btn-outline {
  background: #ffffff;
  color: #0f172a;
  border-color: rgba(0, 0, 0, 0.12);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.btn-outline:hover {
  border-color: #0f172a;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}

.btn-sm {
  padding: 7px 16px;
  font-size: 0.82rem;
}

/* --------------------------------------------------------------------------
   3. ARCHITECTURAL STUDIO HERO & 3D CLOUD STAGE
   -------------------------------------------------------------------------- */
.hero-section {
  position: relative;
  min-height: 100vh;
  padding-top: calc(var(--navbar-height) + 30px);
  padding-bottom: 50px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  background: #fbfbfd;
}

.hero-glow-ambient {
  display: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.35fr;
  gap: 30px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Studio Minimal Tag */
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #f1f5f9;
  border: 1px solid rgba(0, 0, 0, 0.08);
  padding: 5px 14px;
  border-radius: 20px;
  color: #0284c7;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 1px;
  width: fit-content;
}

.ping-indicator {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 8px;
  height: 8px;
}

.ping-dot {
  width: 6px;
  height: 6px;
  background: #16a34a;
  border-radius: 50%;
}

.ping-wave {
  position: absolute;
  width: 14px;
  height: 14px;
  border: 1.5px solid #16a34a;
  border-radius: 50%;
  animation: pingWave 2s infinite ease-out;
}

@keyframes pingWave {
  0% { transform: scale(0.5); opacity: 1; }
  100% { transform: scale(1.8); opacity: 0; }
}

.hero-title {
  font-size: 2.85rem;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -1px;
}

.title-white {
  color: #0f172a;
}

.title-blue {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 60%, #0ea5e9 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.hero-subtitle {
  font-size: 1.2rem;
  font-weight: 600;
  color: #334155;
  letter-spacing: -0.3px;
}

.hero-description {
  font-size: 0.94rem;
  color: #475569;
  line-height: 1.6;
  max-width: 480px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-top: 4px;
  flex-wrap: wrap;
}

/* Hero Quick Credentials Strip */
.hero-badges-strip {
  display: flex;
  gap: 20px;
  margin-top: 10px;
  padding-top: 16px;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  flex-wrap: wrap;
}

.hero-badge-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  color: #475569;
}

.hero-badge-icon {
  color: #0284c7;
  font-size: 0.95rem;
}

/* 3D WebGL Studio Canvas Container & Spatial Pop-Out Framing */
.hero-3d-stage {
  position: relative;
  width: 100%;
  /*height: 520px; */
  height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08), 0 0 1px rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(0, 0, 0, 0.06);
  background: #f3f3f6;
}

#hero-three-canvas {
  width: 100%;
  height: 100%;
  cursor: grab;
}

#hero-three-canvas:active {
  cursor: grabbing;
}

/* 3D Screen-Projected Pop-Out Service Badges */
.hero-spatial-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
  overflow: hidden;
}

.spatial-service-card {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: auto;
  cursor: pointer;
  transform-origin: center center;
  transition: opacity 0.3s ease;
  will-change: transform, opacity;
}

.spatial-card-inner {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(0, 0, 0, 0.09);
  border-radius: 12px;
  padding: 6px 12px 6px 10px;
  box-shadow: 0 10px 24px -5px rgba(0, 0, 0, 0.09), 0 2px 6px rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(16px);
  white-space: nowrap;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.spatial-service-card:hover .spatial-card-inner {
  transform: translateY(-3px) scale(1.04);
  border-color: rgba(2, 132, 199, 0.5);
  box-shadow: 0 14px 30px -5px rgba(2, 132, 199, 0.2), 0 0 0 1.5px rgba(2, 132, 199, 0.25);
  background: #ffffff;
}

.spatial-card-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: rgba(2, 132, 199, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
}

.spatial-card-content {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.spatial-card-num {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 700;
  color: #0284c7;
  letter-spacing: 0.8px;
  line-height: 1.1;
}

.spatial-card-title {
  font-size: 0.78rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
  line-height: 1.2;
}

.spatial-card-cat {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: #64748b;
  line-height: 1.1;
}

.spatial-wa-btn {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(37, 211, 102, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  margin-left: 2px;
}

.spatial-wa-btn:hover {
  background: #25d366;
  transform: scale(1.1);
}

.spatial-wa-btn svg {
  width: 14px;
  height: 14px;
  fill: #16a34a;
}

.spatial-wa-btn:hover svg {
  fill: #ffffff;
}

/* Floating Telemetry HUD Badges */
.hud-telemetry-tag {
  position: absolute;
  padding: 6px 14px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(12px);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  color: #0284c7;
  letter-spacing: 0.8px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  pointer-events: none;
  animation: hudFloat 4s ease-in-out infinite alternate;
}

.tag-top-left { top: 12%; left: 4%; }
.tag-top-right { top: 8%; right: 4%; animation-delay: 1s; }
.tag-bottom-left { bottom: 14%; left: 2%; animation-delay: 2s; }
.tag-bottom-right { bottom: 10%; right: 2%; animation-delay: 1.5s; }

@keyframes hudFloat {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-8px); }
}

/* 3D Viewport Controls Bar */
.hero-3d-controls {
  position: absolute;
  bottom: 12px;
  display: flex;
  gap: 8px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(0, 0, 0, 0.08);
  padding: 4px;
  border-radius: 20px;
  backdrop-filter: blur(16px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  z-index: 5;
}

.ctrl-btn {
  background: transparent;
  border: none;
  color: #64748b;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 14px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.ctrl-btn:hover,
.ctrl-btn.active {
  background: rgba(2, 132, 199, 0.1);
  color: #0284c7;
}

/* --------------------------------------------------------------------------
   3.5 BRAND TICKER MARQUEE ("Trusted by Leading Businesses & Organizations")
   -------------------------------------------------------------------------- */
.brands-marquee-section {
  width: 100%;
  padding: 70px 0 50px;
  background: #fbfbfd;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 5;
}

.brands-marquee-header {
  margin-bottom: 24px;
}

.brands-badge-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #0284c7;
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.2);
  padding: 4px 14px;
  border-radius: 20px;
  margin-bottom: 10px;
}

.brands-marquee-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.4px;
  margin-bottom: 8px;
}

.brands-marquee-subtitle {
  font-size: 0.88rem;
  color: #64748b;
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.55;
}

.marquee-track-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 16px 0;
  mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
}

.marquee-track {
  display: flex;
  gap: 16px;
  width: max-content;
  animation: marqueeScroll 36s linear infinite;
  will-change: transform;
}

.marquee-track-wrapper:hover .marquee-track {
  animation-play-state: paused;
}

@keyframes marqueeScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.brand-capsule-card {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 12px;
  padding: 10px 18px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(12px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
  user-select: none;
}

.brand-capsule-card:hover {
  background: #ffffff;
  border-color: rgba(2, 132, 199, 0.45);
  box-shadow: 0 10px 24px rgba(2, 132, 199, 0.12);
  transform: translateY(-3px);
}

.brand-capsule-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0284c7;
  flex-shrink: 0;
  background: rgba(2, 132, 199, 0.08);
  border-radius: 8px;
  padding: 4px;
  border: 1px solid rgba(2, 132, 199, 0.16);
}

.brand-capsule-card:hover .brand-capsule-icon {
  color: #ffffff;
  background: linear-gradient(135deg, #0284c7, #0369a1);
  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
}

.brand-capsule-icon svg {
  width: 100%;
  height: 100%;
}

.brand-capsule-info {
  display: flex;
  flex-direction: column;
}

.brand-capsule-name {
  font-size: 0.88rem;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.2px;
}

.brand-capsule-cat {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: #64748b;
  letter-spacing: 0.5px;
}

/* --------------------------------------------------------------------------
   4. SERVICES SECTION (3D Perspective Bento Grid)
   -------------------------------------------------------------------------- */
.services-section {
  position: relative;
  padding: 60px 0;
  background: #f8fafc;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

/* 3D Tilt Card Base */
.tilt-card {
  position: relative;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.07);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(16px);
  padding: 28px 24px;
  transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
  transform-style: preserve-3d;
  cursor: pointer;
  overflow: hidden;
}

/* Specular Dynamic Glare Sheen */
.tilt-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  background: radial-gradient(circle at var(--glare-x, 50%) var(--glare-y, 50%), rgba(2, 132, 199, 0.08) 0%, transparent 60%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease;
  z-index: 1;
}

.tilt-card:hover::before {
  opacity: 1;
}

.tilt-card:hover {
  border-color: rgba(2, 132, 199, 0.4);
  box-shadow: 0 16px 36px rgba(2, 132, 199, 0.1), 0 0 0 1px rgba(2, 132, 199, 0.15);
}

.service-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.service-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0284c7;
  margin-bottom: 20px;
  transition: all var(--transition-normal);
}

.service-icon-wrap svg {
  width: 26px;
  height: 26px;
}

.tilt-card:hover .service-icon-wrap {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border-color: #ffffff;
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35);
  transform: translateZ(20px);
}

.service-title {
  font-size: 1.18rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8px;
}

.service-desc {
  font-size: 0.86rem;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 16px;
  flex: 1;
}

.service-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
}

.service-chip {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 3px 8px;
  border-radius: 4px;
  background: #f1f5f9;
  border: 1px solid rgba(0, 0, 0, 0.06);
  color: #0284c7;
}

/* --------------------------------------------------------------------------
   5. WORKING PROCESS ("Our Step-by-Step Approach" S-Curve Journey Flow)
   -------------------------------------------------------------------------- */
.process-journey-section {
  position: relative;
  padding: 100px 0 120px;
  background: #ffffff;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.process-header-simple {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 50px;
}

.process-eyebrow {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 2.2px;
  text-transform: uppercase;
  color: #0284c7;
  margin-bottom: 12px;
  background: rgba(2, 132, 199, 0.08);
  padding: 4px 14px;
  border-radius: 20px;
  border: 1px solid rgba(2, 132, 199, 0.18);
}

.process-title-clean {
  font-size: 2.35rem;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.8px;
  line-height: 1.22;
  margin-bottom: 12px;
}

.process-title-clean .process-accent {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.process-sub-clean {
  font-size: 0.98rem;
  color: #64748b;
  line-height: 1.6;
  margin: 0 auto;
}

/* 6-Step Journey Flow Stage */
.process-journey-stage {
  position: relative;
  max-width: 1040px;
  margin: 0 auto;
  padding: 20px 10px 40px;
}

/* S-Curve Connecting SVG Line */
.journey-track-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.journey-track-path {
  stroke: #0284c7;
  stroke-width: 3.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
  filter: drop-shadow(0 2px 6px rgba(2, 132, 199, 0.25));
}

.journey-pulse-dot {
  filter: drop-shadow(0 0 6px #38bdf8);
}

/* Grid of Rows */
.journey-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  position: relative;
  z-index: 2;
  align-items: start;
}

.journey-row-top {
  margin-bottom: 180px;
}

/* Individual Step Card */
.journey-step-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  cursor: pointer;
  padding: 0 10px;
}

/* Circular Photo Frame */
.journey-circle-frame {
  width: 114px;
  height: 114px;
  border-radius: 50%;
  border: 5px solid #ffffff;
  box-shadow: 0 12px 28px rgba(2, 132, 199, 0.16), 0 4px 10px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(2, 132, 199, 0.12);
  background: #ffffff;
  position: relative;
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  margin-bottom: 6px;
}

.journey-step-card:hover .journey-circle-frame {
  transform: translateY(-6px) scale(1.08);
  box-shadow: 0 20px 40px rgba(2, 132, 199, 0.28), 0 0 0 2.5px #0284c7;
}

.journey-circle-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.journey-step-card:hover .journey-circle-photo {
  transform: scale(1.12);
}

.journey-step-title {
  font-size: 1.3rem;
  font-weight: 800;
  color: #0f172a;
  margin-top: 14px;
  margin-bottom: 8px;
  letter-spacing: -0.4px;
  transition: color 0.3s ease;
}

.journey-step-card:hover .journey-step-title {
  color: #0284c7;
}

.journey-step-text {
  font-size: 0.9rem;
  color: #64748b;
  line-height: 1.55;
  max-width: 250px;
  margin: 0 auto;
}

/* Responsive: Tablet & Mobile */
@media (max-width: 900px) {
  .process-journey-section {
    padding: 70px 0 80px;
  }

  .process-journey-stage {
    padding: 0;
  }

  .journey-track-svg {
    display: none;
  }

  .journey-row {
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .journey-row-top {
    margin-bottom: 20px;
  }

  .journey-step-card {
    flex-direction: row;
    text-align: left;
    align-items: center;
    gap: 20px;
    background: #ffffff;
    padding: 16px 20px;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .journey-circle-frame {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    margin-bottom: 0;
  }

  .journey-step-title {
    margin-top: 0;
    margin-bottom: 4px;
    font-size: 1.15rem;
  }

  .journey-step-text {
    max-width: 100%;
    text-align: left;
    font-size: 0.85rem;
  }
}

/* --------------------------------------------------------------------------
   6. NETWORK TOPOLOGY SECTION
   -------------------------------------------------------------------------- */
.network-section {
  position: relative;
  padding: 90px 0;
  background: #fbfbfd;
}

.network-grid {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 50px;
  align-items: center;
}

.network-info {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.network-diagram-container {
  position: relative;
  width: 100%;
  height: 440px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 20px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.05);
  overflow: hidden;
  backdrop-filter: blur(20px);
}

.network-svg-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.network-link-line {
  fill: none;
  stroke: #0284c7;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 6 6;
  filter: drop-shadow(0 0 6px rgba(2, 132, 199, 0.45));
  transition: stroke 0.3s ease, stroke-width 0.3s ease, filter 0.3s ease;
}

.network-nodes-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
}

.net-node {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: transform var(--transition-fast);
}

.net-node:hover {
  transform: translate(-50%, -50%) scale(1.1);
}

.node-icon-box {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #ffffff;
  border: 1.5px solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0284c7;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  transition: all var(--transition-normal);
}

.net-node:hover .node-icon-box,
.net-node.active .node-icon-box {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  border-color: #ffffff;
  color: #ffffff;
  box-shadow: 0 6px 18px rgba(2, 132, 199, 0.3);
}

.node-icon-box svg {
  width: 24px;
  height: 24px;
}

.node-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: #0f172a;
}

/* Hub Core Switch */
.net-node-hub .node-icon-box {
  width: 72px;
  height: 72px;
  border-radius: 18px;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  border: 2px solid #0284c7;
  box-shadow: 0 8px 25px rgba(2, 132, 199, 0.25);
}

.net-node-hub .node-icon-box svg {
  width: 36px;
  height: 36px;
  color: #38bdf8;
}

/* --------------------------------------------------------------------------
   7. PRODUCT CAROUSEL SECTION
   -------------------------------------------------------------------------- */
.products-section {
  position: relative;
  padding: 90px 0;
  background: #f8fafc;
}

.carousel-container {
  position: relative;
  margin-top: 40px;
}

.carousel-viewport {
  overflow: hidden;
  padding: 20px 0;
}

.carousel-track {
  display: flex;
  gap: 24px;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
}

.product-card {
  flex: 0 0 calc(33.333% - 16px);
  min-width: 280px;
  padding: 24px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.07);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
}

.product-img-wrap {
  width: 100%;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.product-img-wrap svg {
  max-width: 90%;
  max-height: 90%;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
  transition: transform var(--transition-normal);
}

.product-card:hover .product-img-wrap svg {
  transform: scale(1.08);
}

.product-info-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.product-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: #0f172a;
}

.product-tagline {
  font-size: 0.8rem;
  color: #64748b;
}

.product-arrow-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0284c7;
  text-decoration: none;
  transition: all var(--transition-fast);
}

.product-card:hover .product-arrow-btn {
  background: #0284c7;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
}

.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.1);
  color: #0f172a;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  transition: all var(--transition-fast);
}

.carousel-btn:hover {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.2);
}

.carousel-btn-prev { left: -22px; }
.carousel-btn-next { right: -22px; }

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 24px;
}

.carousel-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.carousel-dot.active {
  width: 24px;
  border-radius: 10px;
  background: #0284c7;
  box-shadow: 0 0 8px rgba(2, 132, 199, 0.4);
}

/* --------------------------------------------------------------------------
   8. STATS & WHY CHOOSE US
   -------------------------------------------------------------------------- */
.stats-section {
  position: relative;
  padding: 90px 0;
  background: #fbfbfd;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 50px;
  align-items: center;
}

.stats-visual-rack {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
}

.stats-rack-img {
  width: 100%;
  height: auto;
  display: block;
}

.stats-cards-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 32px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(12px);
  transition: all var(--transition-normal);
}

.stat-item:hover {
  border-color: rgba(2, 132, 199, 0.3);
  box-shadow: 0 10px 24px rgba(2, 132, 199, 0.1);
  transform: translateY(-4px);
}

.stat-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0284c7;
  flex-shrink: 0;
}

.stat-icon svg {
  width: 22px;
  height: 22px;
}

.stat-number {
  font-family: var(--font-mono);
  font-size: 2rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1;
}

.stat-label {
  font-size: 0.8rem;
  color: #64748b;
  margin-top: 4px;
  display: block;
}

/* --------------------------------------------------------------------------
   9. BRANDS & CTA BANNER
   -------------------------------------------------------------------------- */
.brands-section {
  padding: 60px 0;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
}

.brands-title {
  text-align: center;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 2px;
  color: #0284c7;
  margin-bottom: 32px;
}

.brands-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36px;
  flex-wrap: wrap;
}

.brand-item {
  color: #64748b;
  transition: all var(--transition-normal);
}

.brand-item:hover {
  color: #0284c7;
  transform: scale(1.1);
  filter: drop-shadow(0 4px 10px rgba(2, 132, 199, 0.25));
}

.brand-item svg {
  height: 28px;
  width: auto;
}

/* CTA Banner */
.cta-section {
  padding: 60px 0 90px;
  background: #f8fafc;
}

.cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 40px 48px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.06), 0 0 1px rgba(0, 0, 0, 0.08);
}

.cta-left {
  display: flex;
  align-items: center;
  gap: 24px;
}

.cta-cloud-icon {
  width: 60px;
  height: 60px;
  border-radius: 16px;
  background: rgba(2, 132, 199, 0.08);
  border: 1px solid rgba(2, 132, 199, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(2, 132, 199, 0.12);
}

.cta-cloud-icon img {
  width: 36px;
  height: 36px;
  object-fit: contain;
}

.cta-title {
  font-size: 1.65rem;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 6px;
  letter-spacing: -0.5px;
}

.cta-desc {
  font-size: 0.95rem;
  color: #64748b;
}

.cta-actions .btn-outline {
  background: #0f172a;
  color: #ffffff;
  border: 1px solid #0f172a;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.16);
}

.cta-actions .btn-outline:hover {
  background: #0284c7;
  border-color: #0284c7;
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(2, 132, 199, 0.28);
}

/* --------------------------------------------------------------------------
   10. FOOTER (Studio White Theme)
   -------------------------------------------------------------------------- */
.site-footer {
  background: #f4f4f7;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  padding: 50px 0 28px;
}

.footer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 30px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.footer-nav {
  display: flex;
  gap: 24px;
  list-style: none;
}

.footer-link {
  color: #475569;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color var(--transition-fast);
}

.footer-link:hover {
  color: #0284c7;
}

.footer-socials {
  display: flex;
  gap: 12px;
}

.social-icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  text-decoration: none;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
  transition: all var(--transition-fast);
}

.social-icon-btn:hover {
  color: #0284c7;
  border-color: #0284c7;
  background: rgba(2, 132, 199, 0.08);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15);
}

.social-icon-btn svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24px;
  font-size: 0.84rem;
  color: #64748b;
}

.footer-motto {
  font-family: var(--font-mono);
  color: #0284c7;
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* --------------------------------------------------------------------------
   11. MODAL & TOAST
   -------------------------------------------------------------------------- */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(14px);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-overlay.active {
  display: flex;
}

.modal-card {
  width: 100%;
  max-width: 440px;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 16px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
  padding: 22px 24px;
  position: relative;
  max-height: 92vh;
  overflow-y: auto;
  animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalPop {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12px;
}

.modal-title {
  font-size: 1.18rem;
  font-weight: 800;
  color: #0f172a;
}

.modal-desc {
  font-size: 0.78rem;
  color: #64748b;
  margin-top: 2px;
}

.modal-close-btn {
  background: transparent;
  border: none;
  color: #64748b;
  font-size: 1.6rem;
  cursor: pointer;
  line-height: 1;
  transition: color var(--transition-fast);
}

.modal-close-btn:hover {
  color: #0f172a;
}

.form-group {
  margin-bottom: 10px;
}

.form-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 600;
  color: #334155;
  margin-bottom: 4px;
}

.form-input,
.form-select,
.form-textarea {
  width: 100%;
  background: #f8fafc;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 6px;
  padding: 8px 12px;
  color: #0f172a;
  font-family: var(--font-main);
  font-size: 0.82rem;
  transition: border-color var(--transition-fast);
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  outline: none;
  border-color: #0284c7;
  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
}

/* Toast */
.toast-notification {
  position: fixed;
  bottom: 24px;
  right: 24px;
  padding: 14px 20px;
  background: #0f172a;
  border: 1px solid #16a34a;
  border-radius: 12px;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
  transform: translateY(120%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1001;
}

.toast-notification.active {
  transform: translateY(0);
}

/* --------------------------------------------------------------------------
   12. RESPONSIVE BREAKPOINTS
   -------------------------------------------------------------------------- */
@media (max-width: 1024px) {
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .hero-grid,
  .network-grid,
  .stats-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .hero-3d-stage {
    height: 440px;
  }
  .process-cinema-stage {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .process-holo-col {
    position: relative;
    top: 0;
    order: -1;
  }
}

@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }
  .hero-subtitle {
    font-size: 1.1rem;
  }
  .hero-description {
    font-size: 0.9rem;
  }
  .brand-logo-img {
    width: 32px;
    height: 32px;
  }
  .brand-text {
    font-size: 1.1rem;
    letter-spacing: 1px;
  }
  .nav-actions .btn {
    display: none;
  }
  .nav-toggle {
    display: flex;
  }
  .nav-menu {
    position: fixed;
    top: var(--navbar-height);
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(24px);
    flex-direction: column;
    padding: 30px 24px;
    gap: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
    transform: translateY(-120%);
    opacity: 0;
    transition: all var(--transition-normal);
    pointer-events: none;
  }
  .nav-menu .nav-link {
    color: #0f172a;
    font-size: 1.05rem;
  }
  .nav-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu-cta {
    display: block !important;
    width: 100%;
    margin-top: 12px;
  }
  .services-grid {
    grid-template-columns: 1fr;
  }
  .product-card {
    flex: 0 0 100%;
  }
  .stats-cards-row,
  .approvals-grid {
    grid-template-columns: 1fr;
  }
  .cta-banner {
    flex-direction: column;
    text-align: center;
    padding: 30px 20px;
  }
  .cta-left {
    flex-direction: column;
  }
  .footer-top,
  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }
  .footer-nav {
    flex-wrap: wrap;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2.3rem;
  }
  .hero-subtitle {
    font-size: 1.02rem;
    line-height: 1.4;
  }
  .hero-description {
    font-size: 0.88rem;
    max-width: 100%;
  }
  .hero-3d-stage {
    height: 360px;
  }
}

/* --------------------------------------------------------------------------
   13. WHATSAPP SERVICE INTEGRATION STYLES
   -------------------------------------------------------------------------- */
.btn-whatsapp {
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  color: #ffffff !important;
  border-color: rgba(37, 211, 102, 0.4);
  box-shadow: 0 0 24px rgba(37, 211, 102, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.4);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  text-decoration: none;
}

.btn-whatsapp:hover {
  background: linear-gradient(135deg, #2bf075 0%, #0d9e80 100%);
  box-shadow: 0 0 35px rgba(37, 211, 102, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.6);
  transform: translateY(-2px);
  color: #ffffff !important;
}

.btn-whatsapp svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
  flex-shrink: 0;
}

/* Service Card WhatsApp Direct Button */
.service-wa-btn {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 14px;
  padding: 8px 12px;
  background: rgba(37, 211, 102, 0.08);
  border: 1px solid rgba(37, 211, 102, 0.25);
  border-radius: 8px;
  color: #25D366;
  font-size: 0.8rem;
  font-weight: 600;
  text-decoration: none;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.service-wa-btn:hover {
  background: rgba(37, 211, 102, 0.18);
  border-color: #25D366;
  box-shadow: 0 0 14px rgba(37, 211, 102, 0.25);
  transform: translateY(-1px);
  color: #ffffff;
}

.service-wa-btn svg {
  width: 15px;
  height: 15px;
  fill: currentColor;
  flex-shrink: 0;
}

/* Floating WhatsApp Quick-Action Widget */
.floating-whatsapp-widget {
  position: fixed;
  bottom: 28px;
  right: 28px;
  z-index: 999;
  display: flex;
  align-items: center;
}

.wa-float-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  color: #ffffff;
  padding: 12px 18px 12px 14px;
  border-radius: 36px;
  text-decoration: none;
  box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4), 0 0 15px rgba(37, 211, 102, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.25);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.wa-float-btn:hover {
  transform: scale(1.05) translateY(-3px);
  box-shadow: 0 15px 40px rgba(37, 211, 102, 0.6), 0 0 25px rgba(37, 211, 102, 0.4);
}

.wa-float-pulse {
  position: absolute;
  top: -4px;
  left: -4px;
  right: -4px;
  bottom: -4px;
  border-radius: 40px;
  border: 2px solid #25D366;
  animation: waPulse 2s infinite ease-out;
  pointer-events: none;
}

@keyframes waPulse {
  0% { transform: scale(0.95); opacity: 0.8; }
  100% { transform: scale(1.25); opacity: 0; }
}

.wa-float-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wa-float-icon svg {
  width: 100%;
  height: 100%;
  fill: #ffffff;
}

.wa-float-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.86rem;
  font-weight: 700;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.wa-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 6px #ffffff;
}

/* Modal Direct WhatsApp Action */
.modal-wa-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(37, 211, 102, 0.08);
  border: 1px solid rgba(37, 211, 102, 0.25);
  padding: 8px 12px;
  border-radius: 8px;
  margin-bottom: 12px;
  text-decoration: none;
  color: #0f172a;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.modal-wa-banner:hover {
  background: rgba(37, 211, 102, 0.16);
  border-color: #25D366;
  box-shadow: 0 0 16px rgba(37, 211, 102, 0.2);
}

.modal-wa-banner-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-wa-banner-icon {
  width: 20px;
  height: 20px;
  fill: #25D366;
  flex-shrink: 0;
}

.modal-wa-title {
  font-size: 0.8rem;
  font-weight: 700;
  color: #25D366;
}

.modal-wa-subtitle {
  font-size: 0.7rem;
  color: #94a3b8;
}

@media (max-width: 480px) {
  .floating-whatsapp-widget {
    bottom: 18px;
    right: 18px;
  }
  .wa-float-badge .wa-badge-text {
    display: none;
  }
  .wa-float-btn {
    padding: 12px;
    border-radius: 50%;
  }
}

/* --------------------------------------------------------------------------
   13-INCH LAPTOP DISPLAY OPTIMIZATIONS (1280x800, 1366x768, 1440x900)
   -------------------------------------------------------------------------- */
@media (max-width: 1400px) and (min-width: 901px), (max-height: 860px) and (min-width: 901px) {
  /* 1. Hero: prevent vertical scrolling & fit all badges cleanly */
  .hero-section {
    min-height: calc(100vh - 10px);
    padding-top: 85px;
    padding-bottom: 25px;
    justify-content: center;
  }
  .hero-grid {
    gap: 24px;
    grid-template-columns: 0.95fr 1.25fr;
  }
  .hero-content {
    gap: 14px;
  }
  .hero-title {
    font-size: 2.45rem;
    line-height: 1.1;
  }
  .hero-subtitle {
    font-size: 1.05rem;
  }
  .hero-description {
    font-size: 0.88rem;
    line-height: 1.5;
    max-width: 440px;
  }
  .hero-3d-stage {
    height: 380px;
  }
  .hero-badges-strip {
    margin-top: 4px;
    padding-top: 12px;
    gap: 16px;
  }
  .hero-badge-item {
    font-size: 0.78rem;
  }
  .spatial-card-inner {
    padding: 5px 10px 5px 8px;
    gap: 8px;
    transform: scale(0.92);
  }
  .spatial-card-title {
    font-size: 0.74rem;
  }

  /* 2. Services Grid: balanced proportion without tall ballooning */
  .services-section {
    padding: 65px 0 75px;
  }
  .services-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .tilt-card {
    padding: 20px 16px;
  }
  .service-icon-wrap {
    width: 44px;
    height: 44px;
    margin-bottom: 12px;
  }
  .service-icon-wrap svg {
    width: 22px;
    height: 22px;
  }
  .service-title {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .service-desc {
    font-size: 0.84rem;
    line-height: 1.48;
    margin-bottom: 12px;
  }
  .service-chip {
    font-size: 0.68rem;
    padding: 2px 7px;
  }

  /* 3. Process Section: S-Curve stage fits cleanly within 13" screen height */
  .process-journey-section {
    padding: 65px 0 75px;
  }
  .process-header-simple {
    margin-bottom: 35px;
  }
  .process-title-clean {
    font-size: 2.1rem;
  }
  .journey-row-top {
    margin-bottom: 140px;
  }
  .journey-circle-frame {
    width: 104px;
    height: 104px;
  }
  .journey-step-title {
    font-size: 1.15rem;
    margin-top: 10px;
    margin-bottom: 6px;
  }
  .journey-step-text {
    font-size: 0.84rem;
    line-height: 1.45;
    max-width: 230px;
  }

  /* 4. Network Solutions */
  .network-section {
    padding: 65px 0;
  }
  .network-grid {
    gap: 36px;
  }
  .network-diagram-container {
    height: 380px;
  }

  /* 5. Products Carousel */
  .products-section {
    padding: 65px 0;
  }
  .carousel-viewport {
    padding: 10px 0;
  }
  .product-card {
    padding: 20px;
  }
  .product-img-wrap {
    height: 135px;
    margin-bottom: 14px;
  }

  /* 6. About & Stats */
  .about-section {
    padding: 65px 0;
  }
  .about-grid {
    gap: 36px;
  }
  .about-stats-grid {
    gap: 16px;
  }
  .about-stat-card {
    padding: 18px;
  }

  /* 7. CTA & Footer */
  .cta-section {
    padding: 50px 0;
  }
  .cta-banner {
    padding: 36px 42px;
  }
  .site-footer {
    padding: 50px 0 25px;
  }
}
