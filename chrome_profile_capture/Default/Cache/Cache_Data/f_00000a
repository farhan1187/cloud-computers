                <defs>
                  <!-- Neon Glow Filters -->
                  <filter id="intenseCloudGlow" x="-40%" y="-40%" width="180%" height="180%">
                    <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="glow1"/>
                    <feGaussianBlur in="SourceGraphic" stdDeviation="18" result="glow2"/>
                    <feGaussianBlur in="SourceGraphic" stdDeviation="35" result="glow3"/>
                    <feMerge>
