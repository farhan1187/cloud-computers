                <g transform="translate(225, 195)">
                  <!-- Server Unit 1 (Top) -->
                  <g transform="translate(0, 0)">
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#00e5ff" stroke-width="2.5" filter="url(#intenseCloudGlow)"/>
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#ffffff" stroke-width="1" stroke-opacity="0.7"/>
                    <!-- Horizontal Server Disk Slits -->
                    <rect x="18" y="12" width="115" height="10" rx="3" fill="#002b66" stroke="#00b4ff" stroke-width="1.2"/>
                    <circle cx="150" cy="17" r="4" fill="#00ffaa" filter="url(#intenseCloudGlow)"/>
                    <circle cx="168" cy="17" r="4" fill="#00ffff" filter="url(#intenseCloudGlow)"/>
                  </g>

                  <!-- Server Unit 2 (Middle) -->
                  <g transform="translate(0, 46)">
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#00e5ff" stroke-width="2.5" filter="url(#intenseCloudGlow)"/>
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#ffffff" stroke-width="1" stroke-opacity="0.7"/>
                    <!-- Horizontal Server Disk Slits -->
                    <rect x="18" y="12" width="115" height="10" rx="3" fill="#002b66" stroke="#00b4ff" stroke-width="1.2"/>
                    <circle cx="150" cy="17" r="4" fill="#00ffaa" filter="url(#intenseCloudGlow)"/>
                    <circle cx="168" cy="17" r="4" fill="#00ffff" filter="url(#intenseCloudGlow)"/>
                  </g>

                  <!-- Server Unit 3 (Bottom) -->
                  <g transform="translate(0, 92)">
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#00e5ff" stroke-width="2.5" filter="url(#intenseCloudGlow)"/>
                    <rect x="0" y="0" width="190" height="34" rx="7" fill="#08142f" stroke="#ffffff" stroke-width="1" stroke-opacity="0.7"/>
                    <!-- Horizontal Server Disk Slits -->
                    <rect x="18" y="12" width="115" height="10" rx="3" fill="#002b66" stroke="#00b4ff" stroke-width="1.2"/>
                    <circle cx="150" cy="17" r="4" fill="#00ffaa" filter="url(#intenseCloudGlow)"/>
                    <circle cx="168" cy="17" r="4" fill="#00ffff" filter="url(#intenseCloudGlow)"/>
                  </g>
                </g>
              </svg>
            </div>
