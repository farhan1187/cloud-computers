                  <circle cx="160" cy="160" r="4.5" class="constellation-node"/>
                  <circle cx="220" cy="120" r="4" class="constellation-node"/>
                  <circle cx="325" cy="70" r="5.5" class="constellation-node"/>
                  <circle cx="430" cy="120" r="4" class="constellation-node"/>
                  <circle cx="490" cy="175" r="4.5" class="constellation-node"/>
                  <circle cx="540" cy="240" r="4" class="constellation-node"/>
                  <circle cx="520" cy="330" r="4" class="constellation-node"/>
                  <circle cx="460" cy="370" r="4.5" class="constellation-node"/>
                  <circle cx="320" cy="370" r="4" class="constellation-node"/>
                  <circle cx="180" cy="370" r="4.5" class="constellation-node"/>
                  <circle cx="110" cy="320" r="4" class="constellation-node"/>
                  <circle cx="90" cy="240" r="4" class="constellation-node"/>
                  <!-- Inner nodes -->
                  <circle cx="250" cy="180" r="4" class="constellation-node"/>
                  <circle cx="390" cy="180" r="4" class="constellation-node"/>
                  <circle cx="200" cy="240" r="3.5" class="constellation-node"/>
                  <circle cx="440" cy="240" r="3.5" class="constellation-node"/>
                  <circle cx="220" cy="320" r="4" class="constellation-node"/>
                  <circle cx="420" cy="320" r="4" class="constellation-node"/>
