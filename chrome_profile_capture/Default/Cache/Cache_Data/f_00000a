                <!-- 6. Glowing Neon Cloud Contour (Dual stroke for radiant neon bloom) -->
                <!-- Outer bloom -->
                <path d="M460 380 H 180 C 120 380, 70 330, 70 270 C 70 215, 110 170, 160 160 C 185 95, 250 50, 325 50 C 405 50, 470 100, 490 175 C 535 185, 570 225, 570 275 C 570 335, 520 380, 460 380 Z"
                      stroke="url(#cloudNeonGrad)" stroke-width="5" filter="url(#intenseCloudGlow)"/>
