                  <line x1="220" y1="120" x2="325" y2="70"/>
                  <line x1="325" y1="70" x2="430" y2="120"/>
                  <line x1="430" y1="120" x2="490" y2="175"/>
                  <line x1="490" y1="175" x2="540" y2="240"/>
                  <line x1="540" y1="240" x2="520" y2="330"/>
                  <line x1="520" y1="330" x2="460" y2="370"/>
                  <line x1="460" y1="370" x2="320" y2="370"/>
                  <line x1="320" y1="370" x2="180" y2="370"/>
                  <line x1="180" y1="370" x2="110" y2="320"/>
                  <line x1="110" y1="320" x2="90" y2="240"/>
                  <line x1="90" y1="240" x2="160" y2="160"/>
                  <!-- Interior diagonals -->
                  <line x1="220" y1="120" x2="250" y2="180"/>
                  <line x1="325" y1="70" x2="320" y2="160"/>
                  <line x1="430" y1="120" x2="390" y2="180"/>
                  <line x1="160" y1="160" x2="200" y2="240"/>
                  <line x1="490" y1="175" x2="440" y2="240"/>
                  <line x1="110" y1="320" x2="190" y2="320"/>
                  <line x1="520" y1="330" x2="450" y2="320"/>
                  <line x1="250" y1="180" x2="390" y2="180"/>
                  <line x1="200" y1="240" x2="220" y2="320"/>
                  <line x1="440" y1="240" x2="420" y2="320"/>
                  <line x1="220" y1="320" x2="320" y2="340"/>
                  <line x1="420" y1="320" x2="320" y2="340"/>
                  <line x1="250" y1="180" x2="200" y2="240"/>
                  <line x1="390" y1="180" x2="440" y2="240"/>
