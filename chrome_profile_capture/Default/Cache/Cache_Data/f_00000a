    <section id="network" class="network-section">
      <div class="container">
        <div class="network-grid">
          <!-- Left Info Column -->
          <div class="network-info">
            <span class="section-tag">NETWORKING SOLUTIONS</span>
            <h2 class="section-title">
              Build a Faster, Safer and Smarter <span class="text-blue">Network</span>
