              We design and implement reliable network infrastructure for small to large businesses, ensuring seamless connectivity and maximum performance.
            </p>
            <button class="btn btn-primary" data-open-modal="quote" data-service="Networking Solutions">
              Learn More
              <span class="btn-arrow" aria-hidden="true">›</span>
            </button>
          </div>

          <!-- Right Interactive Network Topology Diagram -->
          <div class="network-diagram-container">
            <!-- Dynamic SVG Connecting Lines -->
            <svg class="network-svg-lines" viewBox="0 0 600 420" preserveAspectRatio="none">
              <defs>
                <filter id="lineNeon" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="glow"/>
                  <feMerge>
                    <feMergeNode in="glow"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>
              </defs>

              <!-- Central Switch Hub is at (300, 215) -->
              <!-- Line 1: Switch to Server (400, 70) -->
              <path id="link-server" class="network-link-line" d="M 300 200 C 320 140, 360 90, 400 70" filter="url(#lineNeon)"/>

              <!-- Line 2: Switch to Router (130, 125) -->
              <path id="link-router" class="network-link-line" d="M 270 205 C 220 180, 170 150, 130 125" filter="url(#lineNeon)"/>

              <!-- Line 3: Switch to Access Point (500, 150) -->
              <path id="link-ap" class="network-link-line" d="M 340 210 C 400 195, 450 175, 500 150" filter="url(#lineNeon)"/>

              <!-- Line 4: Switch to PC (130, 335) -->
              <path id="link-pc" class="network-link-line" d="M 270 225 C 210 250, 160 290, 130 335" filter="url(#lineNeon)"/>

              <!-- Line 5: Switch to Laptop (305, 345) -->
