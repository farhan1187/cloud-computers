  <!-- ====================================================================
       INTERACTIVE QUOTE / CONTACT MODAL
       ==================================================================== -->
  <div id="quote-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <h2 id="modal-title" class="modal-title">Request a Consultation</h2>
          <p class="modal-desc">Speak with our certified IT infrastructure engineers.</p>
        </div>
        <button class="modal-close-btn" aria-label="Close dialog">&times;</button>
      </div>

      <form id="quote-form" class="modal-form">
        <div class="form-group">
          <label for="user-name" class="form-label">Full Name *</label>
          <input type="text" id="user-name" class="form-input" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
          <label for="user-email" class="form-label">Work Email *</label>
          <input type="email" id="user-email" class="form-input" placeholder="john@company.com" required>
        </div>

        <div class="form-group">
          <label for="user-phone" class="form-label">Phone Number</label>
          <input type="tel" id="user-phone" class="form-input" placeholder="+1 (555) 000-0000">
        </div>

        <div class="form-group">
          <label for="service-select" class="form-label">Service Needed *</label>
          <select id="service-select" class="form-select" required>
            <option value="" disabled selected>Select a service</option>
            <option value="Networking">Networking &amp; Infrastructure</option>
            <option value="PC Sales & Services">PC Sales &amp; Hardware Support</option>
            <option value="Printer Solutions">Printer &amp; Imaging Solutions</option>
            <option value="Cabling">Structured Cabling &amp; Fiber Optic</option>
            <option value="IT Solutions">Enterprise Cloud &amp; Server Solutions</option>
            <option value="Access & Security">Access Control &amp; CCTV Security</option>
            <option value="Wi-Fi Solutions">Enterprise Wi-Fi &amp; Hotspots</option>
            <option value="Technical Support">24/7 Managed Technical Support</option>
          </select>
        </div>

        <div class="form-group">
          <label for="project-msg" class="form-label">Project Details / Message</label>
          <textarea id="project-msg" class="form-textarea" placeholder="Tell us about your requirements, office size, or infrastructure goals..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">
          Send Request
          <span class="btn-arrow" aria-hidden="true">›</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Toast Notification Alert -->
  <div id="quote-toast" class="toast-notification" role="alert" aria-live="polite">
    <svg style="width: 20px; height: 20px; stroke: #00ffaa; flex-shrink: 0;" viewBox="0 0 24 24" fill="none" stroke-width="2.5">
      <path d="M20 6 9 17l-5-5"/>
