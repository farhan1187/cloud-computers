                    <stop offset="45%" stop-color="#0066ff" stop-opacity="0.15"/>
                    <stop offset="80%" stop-color="#060913" stop-opacity="0"/>
                  </radialGradient>
                  <radialGradient id="baseGroundGlow" cx="50%" cy="50%" r="50%">
